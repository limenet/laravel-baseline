{
    "check": "releaseItBumpsWordpressThemeVersion",
    "description": "fails when release-it never touches style.css, and adds the after:bump hook on fix",
    "engines": ["php"],
    "profiles": ["wordpress"],
    "expect": "fail",
    "fix": {
        "expect": "pass",
        "json": {
            ".release-it.json": {
                "hooks.after:bump": [
                    "node -e 'const fs = require(\"fs\"); fs.writeFileSync(\"style.css\", fs.readFileSync(\"style.css\", \"utf8\").replace(/^([ \\t\\/*#@]*Version:[ \\t]*)[^\\r\\n]*?([ \\t]*(?:\\*\\/|\\?>)[^\\r\\n]*)?(\\r?)$/mi, \"$1${version}$2$3\"))'"
                ],
                "plugins.@release-it/bumper.out.file": "composer.json"
            }
        }
    }
}
